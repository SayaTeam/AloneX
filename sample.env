# ALONE-CODER ENVIRONMENT VARIABLES

# Telegram API credentials from https://my.telegram.org
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# Telegram Bot token from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyZ

# Log group ID (Integer with -100 prefix, bot must be admin)
LOGGER_ID=-1001234567890

# MongoDB URI from https://cloud.mongodb.com
MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority

# Telegram User ID for bot owner
OWNER_ID=1234567890

# Pyrogram v2 String Session for Assistant account
SESSION=

# HTTP Web Server Port for Render / Railway health checks (Default: 8080)
PORT=8080

# Optional Features
AUTO_END=False
AUTO_LEAVE=False
VIDEO_PLAY=True

# Bot Limits
QUEUE_LIMIT=500000000
DURATION_LIMIT=5400000000
PLAYLIST_LIMIT=20000000000

# Support Links
SUPPORT_CHANNEL=https://t.me/ErrorQuote
SUPPORT_CHAT=https://t.me/ErrorQuote
